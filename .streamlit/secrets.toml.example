# Streamlit secrets 模板
#
# 本地开发不需要这个文件——把 Key 写在项目根目录的 .env 里即可（见 .env.example）。
# 这个文件是给 Streamlit Community Cloud 部署用的：
#   部署后在应用的 Settings -> Secrets 里按下面的格式粘贴，然后保存。
#
# 注意：不要把这个文件真正命名为 secrets.toml 后提交到仓库。
# `.streamlit/secrets.toml` 已被 .gitignore 排除，但仍建议只在本机临时使用。

DASHSCOPE_API_KEY = "你的阿里云 DashScope API Key"
TAVILY_API_KEY = "你的 Tavily API Key"
DEEPSEEK_API_KEY = "你的 DeepSeek API Key"
