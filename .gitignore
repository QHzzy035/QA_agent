# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data
.env
chroma_data/
test_data/

# Secrets: Streamlit Cloud 部署用的密钥文件绝不能进仓库
.streamlit/secrets.toml

# Runtime artifacts
logs/
index_record.json

# 本地工具配置：含本机绝对路径与命令白名单，不应随仓库分发
# 注：本机全局 git ignore（~/.config/git/ignore）里也有一条同样的规则，
# 但那条跟着机器走，换台机器就失效。这里显式写一份，不依赖外部配置。
.claude/settings.local.json